cabal-version:      2.4
name:               eink0rn
version:            0.1.0
synopsis:           A minimal Lean 4 proof checker over a reduced core type theory
description:        Consumes lean4export .ndjson files and accepts or rejects them.
                    Everything the export format offers is normalised down to a small
                    core calculus (see SPEC.md) before any type checking happens.
license:            Apache-2.0
license-file:       LICENSE
build-type:         Simple

common warnings
    ghc-options: -Wall -Wcompat -Wincomplete-record-updates
                 -Wincomplete-uni-patterns -Wno-name-shadowing
                 -O2

library
    import:           warnings
    hs-source-dirs:   src
    exposed-modules:  Kernel.Name
                      Kernel.Level
                      Kernel.Expr
                      Kernel.Env
                      Kernel.Cache
                      Kernel.Canon
                      Kernel.Check
                      Kernel.Inductive
                      Front.Json
                      Front.Pool
                      Front.Export
                      Front.Block
                      Front.Hetero
                      Front.Lower
    build-depends:    base >=4.16 && <5
                    , bytestring
                    , containers
                    , array
                    , mtl
    default-language: Haskell2010

executable eink0rn
    import:           warnings
    hs-source-dirs:   app
    main-is:          Main.hs
    build-depends:    base, bytestring, containers, eink0rn
    -- -K512m: the checker recurses over terms as deep as the file makes them.
    -- -A1g: a nursery this size is what the allocation rate wants.  Almost
    -- everything the checker allocates is a rebuilt term that dies before the
    -- next declaration, so a bigger nursery is not merely fewer collections but
    -- less promotion: on std, 512m collects 17.2s and holds 1.22 GB live at the
    -- peak, 1g collects 15.5s and holds 1.08 GB, 2g collects 12.7s and holds
    -- 1.01 GB.  What stops it here is that the nursery is committed at startup
    -- whether the file needs it or not -- 24ms and 16 MB at 512m, 35ms and
    -- 24 MB at 1g, 61ms and 40 MB at 2g -- which a corpus does not notice and a
    -- one-declaration test case is entirely made of.  A run over something the
    -- size of mathlib is worth another 1.5% and can ask for it: +RTS -A2g.
    -- -threaded: for -jN, which checks definition values on several cores once
    -- the file has been walked.  A run without it pays a little for the
    -- capability bookkeeping and nothing else; measured on std, under 1%.
    ghc-options:      -threaded -rtsopts "-with-rtsopts=-K512m -A1g"
    default-language: Haskell2010
